<%- include('partials/header') %>

<main class="error-wrapper py-5 min-vh-75 d-flex align-items-center justify-content-center text-center">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom-glass border-0 p-5 rounded-4 shadow-2xl">
          <div class="error-badge mb-3 text-primary display-1 fw-extrabold">404</div>
          <h1 class="h3 text-white fw-bold mb-3">Page Not Found</h1>
          <p class="text-light-muted mb-4">
            The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
          </p>
          <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
              <i class="bi bi-house me-1"></i> Back to Home
            </a>
            <a href="/admin" class="btn btn-outline-secondary rounded-pill px-4 py-2 text-white">
              <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

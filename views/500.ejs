<%- include('partials/header') %>

<main class="error-wrapper py-5 min-vh-75 d-flex align-items-center justify-content-center text-center">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom-glass border-0 p-5 rounded-4 shadow-2xl border-danger-subtle">
          <div class="error-badge mb-3 text-danger display-1 fw-extrabold">500</div>
          <h1 class="h3 text-white fw-bold mb-3">Internal Server Error</h1>
          <p class="text-light-muted mb-4">
            <%= typeof error !== 'undefined' ? error : 'Something unexpected happened on our server. Please try again in a few moments.' %>
          </p>
          <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
              <i class="bi bi-arrow-left me-1"></i> Return to Safety
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
